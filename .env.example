# Copy to .env and fill in. scripts/deploy.sh reads from this file.
#
# The CF token needs: Workers Scripts:Edit, Workers R2 Storage:Edit,
# D1:Edit, Zone DNS:Edit on the zone hosting your custom domain.
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=
ANTHROPIC_API_KEY=sk-ant-...

# Optional overrides — sensible defaults in scripts/deploy.sh:
# GEOLYSSA_WORKER_NAME=geolyssa
# GEOLYSSA_HOSTNAME=geolyssa.yourdomain.net
# GEOLYSSA_ZONE_NAME=yourdomain.net
# GEOLYSSA_R2_BUCKET=geolyssa-photos
# GEOLYSSA_D1_DB=geolyssa
